{
  "name": "agent-empire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:dashboard": "cd src/dashboard && next build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "bullmq": "^5.0.0",
    "clsx": "^2.1.1",
    "dockerode": "^4.0.0",
    "drizzle-orm": "^0.30.0",
    "hono": "^4.0.0",
    "ioredis": "^5.3.0",
    "jose": "^5.0.0",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.0.0",
    "next": "^14.2.35",
    "octokit": "^3.1.0",
    "pino": "^8.0.0",
    "postgres": "^3.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.22.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^8.0.0",
    "supertest": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
